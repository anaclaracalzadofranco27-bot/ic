import urllib.parse
from http.server import BaseHTTPRequestHandler, HTTPServer


class ThreadingHTTPServer(socketserver.ThreadingMixIn, HTTPServer):
    daemon_threads = True


HTML_CONCEITUAL = r"""<!DOCTYPE html>
<html lang="pt-BR">
<head>
